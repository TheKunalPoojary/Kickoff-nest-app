# ---- core ----
NODE_ENV=development
# 3000-3002 / 3333 / 8081 are commonly taken by other local dev servers.
PORT=4300

# ---- database ----
# Postgres 16+. btree_gist is required for the booking exclusion constraint.
DATABASE_URL="postgresql://kickoff:kickoff@localhost:5433/kickoff?schema=public"

# ---- auth ----
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="replace-with-openssl-rand-base64-48"
JWT_REFRESH_SECRET="replace-with-a-different-openssl-rand-base64-48"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30

# ---- booking ----
# How long a PENDING_PAYMENT hold blocks a slot before the sweeper expires it.
BOOKING_HOLD_MINUTES=10

# ---- redis ----
# NOTE: do NOT reuse another project's Redis. Key collisions and a stray
# FLUSHDB will silently wipe the other project's cache. Dedicated instance,
# or at minimum a dedicated DB index + the kickoff: key prefix.
REDIS_URL="redis://localhost:6380/0"

# ---- payments (Razorpay) ----
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
