# ---- core ----
NODE_ENV=development
# 3000-3002 / 3333 / 8081 are commonly taken by other local dev servers.
PORT=4300

# ---- database ----
# Postgres 16+. btree_gist is required for the booking exclusion constraint.
DATABASE_URL="postgresql://kickoff:kickoff@localhost:5433/kickoff?schema=public"

# ---- auth ----
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="replace-with-openssl-rand-base64-48"
JWT_REFRESH_SECRET="replace-with-a-different-openssl-rand-base64-48"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30

# ---- booking ----
# How long a PENDING_PAYMENT hold blocks a slot before the sweeper expires it.
BOOKING_HOLD_MINUTES=10

# ---- otp ----
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=3
OTP_MAX_REQUESTS_PER_HOUR_PER_IP=20

# ---- email/password login ----
LOGIN_MAX_ATTEMPTS_PER_HOUR=10
LOGIN_MAX_ATTEMPTS_PER_HOUR_PER_IP=30

# ---- google oauth ----
# Comma-separated: one OAuth client ID per platform from Google Cloud Console
# (iOS, Android, Web). Required in production. The backend accepts a Google ID
# token whose `aud` claim matches any of these.
GOOGLE_OAUTH_CLIENT_IDS="xxxx-ios.apps.googleusercontent.com,xxxx-android.apps.googleusercontent.com,xxxx-web.apps.googleusercontent.com"

# ---- redis ----
# NOTE: do NOT reuse another project's Redis. Key collisions and a stray
# FLUSHDB will silently wipe the other project's cache. Dedicated instance,
# or at minimum a dedicated DB index + the kickoff: key prefix.
REDIS_URL="redis://localhost:6380/0"

# ---- uploads ----
# Venue photos are written here and served at ${PUBLIC_BASE_URL}/uploads.
UPLOAD_DIR="./uploads"
PUBLIC_BASE_URL="http://localhost:4300"

# ---- portal ----
# Browser origins allowed to call the API (comma-separated). 4302 = kickoff-portal dev server.
CORS_ORIGINS="http://localhost:4302"

# ---- dev seed logins (portal) ----
# Used only by `npx prisma db seed`. owner@kickoff.local / admin@kickoff.local
SEED_OWNER_PASSWORD="owner-dev-1234"
SEED_ADMIN_PASSWORD="admin-dev-1234"

# ---- payments (Razorpay) ----
# Required in production; the app refuses to boot without them.
# Locally, any non-empty values work — the webhook secret must match whatever
# is configured in the Razorpay dashboard, since the HMAC is computed with it.
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
RAZORPAY_WEBHOOK_SECRET="..."

# ---- push notifications (Expo) ----
# Optional: only needed if enhanced push security is enabled on the Expo project.
EXPO_ACCESS_TOKEN=""
# Max messages a venue owner can send per venue per rolling 24h (admins unlimited).
PUSH_OWNER_MAX_PER_DAY=5
